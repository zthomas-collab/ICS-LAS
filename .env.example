# Copy to .env.local for local overrides. Never commit real secrets.

# Leave unset locally to use PGlite at ./.data/pglite. Required in production.
# DATABASE_URL=postgres://ics_web:CHANGE_ME@localhost:5432/ics_las
# PGLITE_DATA_DIR=./.data/pglite
# MIGRATE_ON_START=false

APP_BASE_URL=http://localhost:3000

# Basemap (development default: OpenFreeMap, no SLA). Production: licensed provider.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_TILE_ORIGINS=https://tiles.openfreemap.org
NEXT_PUBLIC_DEFAULT_VIEW=-82.55,35.6,9

# Forced to true in production.
# REQUIRE_MFA_FOR_PRIVILEGED=false

# Crisis Compass branding (all optional; invalid or low-contrast values are ignored with a warning).
# Defaults are placeholders until official brand assets are supplied.
# BRAND_NAME=Crisis Compass
# BRAND_TAGLINE=Coordinating help when it matters most.
# BRAND_OPERATOR=Hiraeth Ventures
# BRAND_LOGO_PATH=/brand/logo.svg
# BRAND_COLOR_PRIMARY=#205c4b
# BRAND_COLOR_INTERACTIVE=#2684b8
# BRAND_COLOR_LINK=#1d6a95
# BRAND_COLOR_SOFT=#bde8d2
# BRAND_COLOR_ACCENT=#f0b84b
# BRAND_COLOR_BACKGROUND=#faf9f4
# BRAND_COLOR_TEXT=#24343a

# Email delivery (required in production). Any provider that offers SMTP works.
# EMAIL_TRANSPORT=smtp
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# EMAIL_FROM="Crisis Compass <no-reply@your-domain.example>"

# Multi-factor authentication secrets are encrypted with this key (required in production).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MFA_ENCRYPTION_KEY=

# Sign-in in production: emailed one-time link + authenticator code for staff. Requires the three settings below.
# AUTH_PROVIDER=magic-link-mfa

# Private S3-compatible object storage for documents and logos (required in production).
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=            # only for non-AWS providers (R2, B2, MinIO)
# S3_PREFIX=

# Malware scanning of uploads via a ClamAV daemon (required in production for document uploads).
# SCANNER=clamd
# CLAMD_HOST=
# CLAMD_PORT=3310
