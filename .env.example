# Copy to .env.local for local overrides. Never commit real secrets.

# Leave unset locally to use PGlite at ./.data/pglite. Required in production.
# DATABASE_URL=postgres://ics_web:CHANGE_ME@localhost:5432/ics_las
# PGLITE_DATA_DIR=./.data/pglite
# MIGRATE_ON_START=false

APP_BASE_URL=http://localhost:3000

# Basemap (development default: OpenFreeMap, no SLA). Production: licensed provider.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_TILE_ORIGINS=https://tiles.openfreemap.org
NEXT_PUBLIC_DEFAULT_VIEW=-82.55,35.6,9

# Forced to true in production.
# REQUIRE_MFA_FOR_PRIVILEGED=false
